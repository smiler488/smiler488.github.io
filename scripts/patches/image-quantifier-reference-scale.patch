+def reference_size_px(contour: np.ndarray) -> Tuple[float, str]:
+    """Size of a reference object in pixels, independent of its rotation.
+
+    A round object (circularity > 0.85) is a coin: its size is the diameter
+    of the circle with the same area. Otherwise it is a square: its size is
+    the mean side of the minimum-area rotated rectangle. The axis-aligned
+    bounding box would overestimate a rotated square by up to 41% (45°).
+    """
+    area = float(cv2.contourArea(contour))
+    peri = float(cv2.arcLength(contour, True))
+    circularity = 4.0 * np.pi * area / (peri * peri + 1e-9)
+    if circularity > 0.85:
+        return float(np.sqrt(4.0 * area / np.pi)), "coin"
+    (_, _), (w, h), _ = cv2.minAreaRect(contour)
+    return float((w + h) / 2.0), "square"
+
+
